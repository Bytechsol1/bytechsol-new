<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ---------------------------------------------------------------
    # 1. Force HTTPS
    # ---------------------------------------------------------------
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://bytechsolllc.com/$1 [L,R=301]

    # ---------------------------------------------------------------
    # 2. Force non-WWW
    # ---------------------------------------------------------------
    RewriteCond %{HTTP_HOST} ^www\.bytechsolllc\.com$ [NC]
    RewriteRule ^(.*)$ https://bytechsolllc.com/$1 [L,R=301]

    # ---------------------------------------------------------------
    # 3. WordPress /cms — pass through (do NOT rewrite)
    # ---------------------------------------------------------------
    RewriteCond %{REQUEST_URI} ^/cms [NC]
    RewriteRule ^(.*)$ - [L]

    # ---------------------------------------------------------------
    # 4. Serve existing static files and folders normally
    # ---------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ---------------------------------------------------------------
    # 5. Serve pre-rendered .html files without extension
    # ---------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+)$ $1.html [L]

    # ---------------------------------------------------------------
    # 6. React SPA fallback — everything else serves index.html
    # ---------------------------------------------------------------
    RewriteRule ^ index.html [L]

</IfModule>
# ---------------------------------------------------------------
# SECURITY HEADERS
# Protects against XSS, clickjacking, MIME sniffing, etc.
# Google uses HTTPS/security as a ranking signal.
# ---------------------------------------------------------------
<IfModule mod_headers.c>

    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Prevent clickjacking (embedding in iframes)
    Header always set X-Frame-Options "SAMEORIGIN"

    # Enable browser XSS filter (legacy but still useful)
    Header always set X-XSS-Protection "1; mode=block"

    # Control referrer information sent to other sites
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Restrict access to browser APIs (camera, mic, geolocation)
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"

    # Remove server fingerprinting headers
    Header unset X-Powered-By
    Header always unset X-Powered-By

    # Cache-Control for HTML pages (short cache, revalidate)
    <FilesMatch "\.(html)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # Revalidate JS/CSS because this build uses fixed filenames
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # Long-term cache for fonts and images
    <FilesMatch "\.(woff|woff2|ttf|otf|eot|svg|png|jpg|jpeg|gif|webp|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

</IfModule>

# ---------------------------------------------------------------
# GZIP COMPRESSION
# Reduces file size for faster delivery — improves Core Web Vitals
# ---------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# ---------------------------------------------------------------
# BROWSER CACHING VIA EXPIRES
# Complements the Cache-Control headers above
# ---------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On

    # HTML — short-lived (content changes frequently)
    ExpiresByType text/html                 "access plus 1 hour"

    # CSS and JS - revalidate fixed filenames after updates
    ExpiresByType text/css                  "access plus 0 seconds"
    ExpiresByType application/javascript    "access plus 0 seconds"
    ExpiresByType text/javascript           "access plus 0 seconds"

    # Images
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType image/gif                 "access plus 1 year"
    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType image/x-icon              "access plus 1 year"

    # Fonts
    ExpiresByType font/ttf                  "access plus 1 year"
    ExpiresByType font/woff                 "access plus 1 year"
    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType font/otf                  "access plus 1 year"

    # XML / JSON
    ExpiresByType application/json          "access plus 0 seconds"
    ExpiresByType application/xml           "access plus 0 seconds"
    ExpiresByType text/xml                  "access plus 0 seconds"

</IfModule>

# ---------------------------------------------------------------
# DISABLE DIRECTORY LISTING
# Prevents attackers from browsing your file structure
# ---------------------------------------------------------------
Options -Indexes